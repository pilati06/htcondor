executable   = gpu_check.bat
requirements = (OpSys == "WINDOWS") && (Arch == "X86_64")
request_cpus   = 1
request_memory = 1GB
request_disk   = 1GB
request_gpus   = 1

# O job no Windows recebe um ambiente minimo, sem o PATH do sistema.
# Colocamos o System32 e a pasta do NVSMI no PATH do job.
environment = "PATH='C:\Windows\System32;C:\Windows;C:\Windows\System32\Wbem;C:\Program Files\NVIDIA Corporation\NVSMI'"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = gpu_check.bat

output = gpu.$(Cluster).$(Process).out
error  = gpu.$(Cluster).$(Process).err
log    = gpu.$(Cluster).log

queue
