# Diagnostico do WinError -2147467259 ao criar venv no lab1-desktop-23
executable   = diag_venv.bat
requirements = (OpSys == "WINDOWS") && (HAS_PYTHON312 =?= True)

request_cpus   = 1
request_memory = 1GB
request_disk   = 1GB
load_profile   = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = diag_venv.py

output = diag_venv.$(Cluster).out
error  = diag_venv.$(Cluster).err
log    = diag_venv.$(Cluster).log

queue
