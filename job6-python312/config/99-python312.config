# Copie para C:\condor\config\ no no Windows (ex.: lab1-desktop-23) DEPOIS
# de rodar instalar_python312.ps1, e rode "condor_reconfig" como Administrador.
#
# Anuncia no ClassAd da maquina que ela tem Python 3.12 e onde ele esta.
# Assim os jobs podem pedir:  requirements = (HAS_PYTHON312 =?= True)
# e nunca caem em um no Windows que so tenha o 3.14 quebrado.

HAS_PYTHON312  = True
PYTHON312_PATH = "C:\Program Files\Python312\python.exe"
STARTD_ATTRS   = $(STARTD_ATTRS) HAS_PYTHON312 PYTHON312_PATH
